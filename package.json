{
  "name": "pi-charset",
  "version": "0.1.1",
  "description": "Encoding-aware read, write, edit, and grep extension for Pi",
  "type": "module",
  "license": "MIT",
  "author": "ethan-blue",
  "homepage": "https://github.com/ethan-blue/pi-charset#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ethan-blue/pi-charset.git"
  },
  "bugs": {
    "url": "https://github.com/ethan-blue/pi-charset/issues"
  },
  "keywords": [
    "pi-package",
    "pi-extension",
    "charset",
    "encoding",
    "gb18030",
    "gbk",
    "big5",
    "euc-kr",
    "shift-jis",
    "iso-8859-1",
    "utf-8",
    "chinese",
    "crlf",
    "line-endings"
  ],
  "engines": {
    "node": ">=22.19.0"
  },
  "files": [
    "src",
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    "docs/*.md",
    "examples",
    "tools/*.mjs"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "verify": "npm run typecheck && npm run test",
    "fixtures": "node test/fixtures/gen.ts",
    "scan": "node tools/scan-encoding.mjs",
    "prepublishOnly": "npm run verify"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": ">=0.84.0",
    "@earendil-works/pi-coding-agent": ">=0.84.0",
    "@earendil-works/pi-tui": ">=0.84.0",
    "typebox": "*"
  },
  "dependencies": {
    "iconv-lite": "^0.6.3",
    "micromatch": "^4.0.8"
  },
  "overrides": {
    "undici": "^8.12.3"
  },
  "devDependencies": {
    "@types/micromatch": "^4.0.10",
    "@types/node": "^22.0.0",
    "typescript": "^5.5.0",
    "vitest": "^4.1.12"
  },
  "pi": {
    "extensions": [
      "./src/index.ts"
    ]
  }
}
