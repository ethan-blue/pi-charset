# Normalize text files in the repository to LF
* text=auto eol=lf

# Treat binary files as raw bytes without line-ending conversion
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.webp binary
*.class binary
*.jar binary
*.zip binary
*.ttf binary
*.eot binary
*.woff binary
*.woff2 binary
*.pdf binary
